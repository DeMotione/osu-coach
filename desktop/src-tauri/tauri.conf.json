{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "osu! coach",
  "version": "0.9.1",
  "identifier": "app.osucoach.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "osu! coach",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb"],
    "publisher": "DeMotione",
    "homepage": "https://github.com/DeMotione/osu-coach",
    "license": "MIT",
    "category": "Game",
    "shortDescription": "Analyses your osu!standard replays and tells you what to work on",
    "longDescription": "osu! coach reads your own osu!standard replays, replays every note against the beatmap and measures how you aim and tap: skill scores, miss causes, setup tips, map suggestions and practice playlists. Everything runs on your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
